{"is_source_file": true, "format": "JavaScript", "description": "This file defines a service to process and aggregate hierarchical LLM cost data stored in a MongoDB collection. It includes functions to project, normalize, group, and format cost-related data, with detailed handling of various schema variants. The main functions are `aggregateHierarchy` for retrieving the aggregated data and `ensureLlmCostsIndexes` for setting up database indexes.", "external_files": ["../config/db", "../utils/credits"], "external_methods": ["getDb", "usdToCredits"], "published": ["aggregateHierarchy", "ensureLlmCostsIndexes"], "classes": [], "methods": [{"name": "projectionStage()", "description": "Defines a MongoDB projection stage that normalizes various schema variants for fields like user_id, project_id, agent_name, date, input_tokens, output_tokens, and cost.", "scope": "", "scopeKind": ""}, {"name": "addDateKeyStage()", "description": "Adds a standardized date object ($dateObj) from raw date fields for consistent date processing.", "scope": "", "scopeKind": ""}, {"name": "projectDateKeyStage()", "description": "Projects key fields and converts date to a date string (YYYY-MM-DD) format for grouping.", "scope": "", "scopeKind": ""}, {"name": "groupByAgentDateStage()", "description": "Groups data by user, project, agent, and date, summing costs and tokens per day.", "scope": "", "scopeKind": ""}, {"name": "groupAgentTotalsStage()", "description": "Aggregates data per agent, summing costs over days, and building nested objects for costs and tokens indexed by date.", "scope": "", "scopeKind": ""}, {"name": "agentProjectStage()", "description": "Prepares the agent-level documents with formatted costs and nested date-based summaries.", "scope": "", "scopeKind": ""}, {"name": "groupProjectStage()", "description": "Groups data by user and project, collecting agent details and total costs.", "scope": "", "scopeKind": ""}, {"name": "projectProjectStage()", "description": "Projects the project summary, including cost formatting.", "scope": "", "scopeKind": ""}, {"name": "groupUserStage()", "description": "Aggregates data to user level, summing project costs and collecting project details.", "scope": "", "scopeKind": ""}, {"name": "finalProjectStage()", "description": "Finalizes the aggregation result with user ID, total cost, and nested projects.", "scope": "", "scopeKind": ""}, {"name": "aggregateHierarchy({ filter = {}, tenantId } = {})", "description": "Main function that runs the aggregation pipeline to produce hierarchical LLM cost summaries for users, projects, and agents, with cost formatting and conversion.", "scope": "", "scopeKind": ""}, {"name": "ensureLlmCostsIndexes()", "description": "Creates indexes on the llm-costs collection to optimize query performance for various field-based filters.", "scope": "", "scopeKind": ""}], "calls": ["getDb", "aggregate", "createIndex", "usdToCredits"], "search-terms": ["llmCostsHierarchy", "aggregateHierarchy", "MongoDB aggregation", "cost normalization", "hierarchical LLM cost", "index creation llm-costs"], "state": 2, "file_id": 297, "knowledge_revision": 1190, "git_revision": "6d3375a372d39a7e0fc42e093db732a2bc42b5a0", "ctags": [{"_type": "tag", "name": "addDateKeyStage", "path": "/home/kavia/workspace/code-generation/data-management-dashboard-144914-144923/mongodb_dashboard_backend/src/services/llmCostsHierarchy.service.js", "pattern": "/^function addDateKeyStage() {$/", "language": "JavaScript", "kind": "function", "signature": "()"}, {"_type": "tag", "name": "agentProjectStage", "path": "/home/kavia/workspace/code-generation/data-management-dashboard-144914-144923/mongodb_dashboard_backend/src/services/llmCostsHierarchy.service.js", "pattern": "/^function agentProjectStage() {$/", "language": "JavaScript", "kind": "function", "signature": "()"}, {"_type": "tag", "name": "aggregateHierarchy", "path": "/home/kavia/workspace/code-generation/data-management-dashboard-144914-144923/mongodb_dashboard_ba