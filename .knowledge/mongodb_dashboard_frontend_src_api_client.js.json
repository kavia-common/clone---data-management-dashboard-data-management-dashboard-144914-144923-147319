}, {"name": "deleteSession(id)", "description": "Deletes a session record by ID.", "scope": "", "scopeKind": ""}, {"name": "listDeployments(params = {})", "description": "Retrieves a list of deployment records.", "scope": "", "scopeKind": ""}, {"name": "createDeployment(body)", "description": "Creates a new deployment record.", "scope": "", "scopeKind": ""}, {"name": "updateDeployment(id, body)", "description": "Updates a deployment record by ID.", "scope": "", "scopeKind": ""}, {"name": "deleteDeployment(id)", "description": "Deletes a deployment record by ID.", "scope": "", "scopeKind": ""}, {"name": "listLlmCosts(params = {})", "description": "Retrieves a list of LLM cost records with optional filters.", "scope": "", "scopeKind": ""}, {"name": "getTenantNavigation(tenantId)", "description": "Fetches navigation hierarchy (groups, users, projects) for a tenant.", "scope": "", "scopeKind": ""}, {"name": "getTenantCreditsSummary(tenantId)", "description": "Fetches credit summary and breakdowns for a tenant.", "scope": "", "scopeKind": ""}, {"name": "getTenantUsersUsage(tenantId, params = {})", "description": "Fetches per-user usage data for a tenant.", "scope": "", "scopeKind": ""}, {"name": "getProjectOverview(projectId)", "description": "Fetches overview data for a specific project.", "scope": "", "scopeKind": ""}, {"name": "getProjectUsersUsage(projectId)", "description": "Fetches per-user usage data within a project.", "scope": "", "scopeKind": ""}], "calls": ["axios.create", "axios.get", "api.post", "api.put", "api.delete"], "search-terms": ["API client", "axios interceptors", "environment-driven URL", "localStorage token", "React API", "backend health", "user management", "session tracking", "deployments", "costs", "tenants", "projects", "usage"], "state": 2, "file_id": 13, "knowledge_revision": 262, "git_revision": "586b2e61de3205bf2a89b8ad1948adf9f8e1c430", "revision_history": [{"28": ""}, {"80": "f7c3641499e7ceb5dc391adbe90800e94ff37f29"}, {"81": "8c6d22415a