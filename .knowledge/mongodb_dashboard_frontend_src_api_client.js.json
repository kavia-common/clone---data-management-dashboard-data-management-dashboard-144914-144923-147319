{"is_source_file": true, "format": "JavaScript", "description": "This file defines an API client for a React-based frontend application. It handles configuration of API base URLs based on environment variables and window location, manages authentication tokens and user profiles in localStorage, and provides functions to interact with backend API endpoints related to users, sessions, deployments, costs, tenants, projects, and usage data. It uses axios for HTTP requests and includes interceptors for authorization and error handling.", "external_files": ["axios"], "external_methods": [], "published": ["getApiClient", "getStoredAuth", "persistAuth", "health", "loginApi", "registerApi", "listUsers", "createUser", "updateUser", "deleteUser", "listSessions", "createSession", "updateSession", "deleteSession", "listDeployments", "createDeployment", "updateDeployment", "deleteDeployment", "listLlmCosts", "getTenantNavigation", "getTenantCreditsSummary", "getTenantUsersUsage", "getProjectOverview", "getProjectUsersUsage"], "classes": [], "methods": [{"name": "resolveBackendBase()", "description": "Determines the backend base URL based on environment variables or window location, with a fallback to an empty string.", "scope": "", "scopeKind": ""}, {"name": "joinUrl(base, path)", "description": "Concatenates the base URL with a given path, normalizing slashes.", "scope": "", "scopeKind": ""}, {"name": "getToken()", "description": "Retrieves the stored authentication token from localStorage.", "scope": "", "scopeKind": ""}, {"name": "setToken(token)", "description": "Stores or removes the authentication token in localStorage.", "scope": "", "scopeKind": ""}, {"name": "setUser(user)", "description": "Stores or removes the user profile in localStorage.", "scope": "", "scopeKind": ""}, {"name": "getUser()", "description": "Retrieves the stored user profile from localStorage.", "scope": "", "scopeKind": ""}, {"name": "normalizeListResponse(res)", "description": "Normalizes the list r