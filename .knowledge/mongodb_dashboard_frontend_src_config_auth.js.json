import { generateOrganizationId, isTenantSaltValid } from "../utils/crypto";;

// -----------------------------------------------------------------------------
// DYNAMIC ORGANIZATION ENCRYPTION USING SECRET SALT
// -----------------------------------------------------------------------------

// Base API URL from environment
export const API_BASE_URL = process.env.REACT_APP_API_BASE_URL || "http://localhost:3001";

// Secret salt from .env — MUST be configured
const SECRET_SALT = process.env.REACT_APP_SECRET_SALT;

/**
 * Generate deterministic encrypted organization ID based on email
 */
export function generateOrganizationId(email) {
  if (!SECRET_SALT) {
    throw new Error("SECRET_SALT is not configured in environment variables.");
  }

  if (!email) {
    throw new Error("Email is required to generate organization ID.");
  }

  const normalizedEmail = email.trim().toLowerCase();

  const hash = crypto
    .createHmac("sha256", SECRET_SALT)
    .update(normalizedEmail)
    .digest("base64")
    .replace(/[^a-zA-Z0-9]/g, "")
    .substring(0, 24);

  return hash;
}

// -----------------------------------------------------------------------------
// AUTH STORAGE UTILITIES
// -----------------------------------------------------------------------------

export const AUTH_STORAGE_KEY = "auth";

export function getStoredAuth() {
  try {
    const raw = localStorage.getItem(AUTH_STORAGE_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

export function isAuthenticated() {
  return !!getStoredAuth();
}

export function saveAuthSession(token) {
  try {
    localStorage.setItem(AUTH_STORAGE_KEY, JSON.stringify(token));
  } catch (err) {
    console.warn("Failed to store auth session:", err);
  }
}

export function clearAuthSession() {
  try {
    localStorage.removeItem(AUTH_STORAGE_KEY);
  } catch (err) {
    console.warn("Failed to clear auth session:", err);
  }
}

// -----------------------------------------------------------------------------
// VALIDATION HELPERS
// -----------------------------------------------------------------------------

export function isTenantSaltValid() {
  return !!SECRET_SALT;
}

export const VALIDATED_TENANT_SALT = SECRET_SALT;
