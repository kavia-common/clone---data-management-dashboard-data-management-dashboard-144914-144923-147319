/**
 * Authentication and API configuration
 * ------------------------------------
 * Handles API connection settings, authentication session storage,
 * and secure dynamic organization ID generation using AES encryption.
 */

import CryptoJS from "crypto-js"; // install: npm install crypto-js

// ===== Environment Setup =====
export const API_BASE_URL =
  process.env.REACT_APP_API_BASE_URL || "http://localhost:3001";

// ===== Secret Salt Handling =====
const SECRET_KEY = process.env.REACT_APP_SECRET_SALT; // this is your encryption key
const SECRET_SALT_ID = "67486f90cb935d7165b796ba397e1c23"; // base salt to be encrypted

const FALLBACK_KEY = "fallback_dev_key";

/**
 * Encrypts the secret salt ID using AES with the secret key.
 * Returns a Base64URL-safe string to use as organization_id.
 */
function encryptOrganizationId(key, saltId) {
  try {
    const encrypted = CryptoJS.AES.encrypt(saltId, key).toString();
    // Make it URL-safe
    return encrypted.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  } catch (err) {
    console.warn("Error encrypting organization ID:", err);
    return "fallback-org-id";
  }
}

// Generate the dynamic encrypted organization ID
export const VALIDATED_TENANT_SALT = encryptOrganizationId(
  SECRET_KEY || FALLBACK_KEY,
  SECRET_SALT_ID
);

// ===== Auth Storage =====
export const AUTH_STORAGE_KEY = "auth";

/**
 * Retrieves and parses the stored authentication object from local storage.
 */
export function getStoredAuth() {
  try {
    const stored = localStorage.getItem(AUTH_STORAGE_KEY);
    return stored ? JSON.parse(stored) : null;
  } catch (err) {
    console.warn("Failed to parse stored auth:", err);
    return null;
  }
}

/**
 * Checks if the user is currently authenticated.
 */
export function isAuthenticated() {
  const auth = getStoredAuth();
  return !!(auth && auth.token);
}

/**
 * Saves login session info into local storage.
 */
export function saveAuthSession(token) {
  if (!token) return;
  localStorage.setItem(AUTH_STORAGE_KEY, JSON.stringify({ token }));
}

/**
 * Clears authentication session data.
 */
export function clearAuthSession() {
  localStorage.removeItem(AUTH_STORAGE_KEY);
}
