{"is_source_file": true, "format": "JavaScript", "description": "This file contains utility functions for cryptographic operations related to tenant ID encryption and validation, using CryptoJS library. It defines functions for validating base64url salts, deriving AES keys, encrypting and decrypting tenant IDs, and a validation check for the environment configuration.", "external_files": ["../config/auth"], "external_methods": ["CryptoJS.SHA256", "CryptoJS.AES.encrypt", "CryptoJS.AES.decrypt", "CryptoJS.enc.Base64.parse", "CryptoJS.enc.Utf8.stringify"], "published": ["isTenantSaltValid", "encryptTenantId", "decryptTenantId", "setTenantEncryptionSalt"], "classes": [], "methods": [{"name": "isUrlSafeShortBase64(s)", "description": "Validates that the provided string appears URL-safe base64 without padding, and has a length between 20 and 44 characters.", "scope": "", "scopeKind": ""}, {"name": "stripBase64Padding(b64)", "description": "Removes trailing '=' padding characters from a base64 string.", "scope": "", "scopeKind": ""}, {"name": "toWordArray(buf)", "description": "Converts a Uint8Array or Buffer into a CryptoJS WordArray.", "scope": "", "scopeKind": ""}, {"name": "deriveAes128KeyFromBase64UrlSalt(saltB64Url)", "description": "Derives a 16-byte AES-128 key from a base64url-encoded salt by decoding, hashing with SHA256, and taking the first 16 bytes.", "scope": "", "scopeKind": ""}, {"name": "isTenantSaltValid()", "description": "Checks if the configured tenant salt appears URL-safe base64 without padding.", "scope": "", "scopeKind": ""}, {"name": "encryptTenantId(tenantId)", "description": "Encrypts a tenant ID string using AES-128-ECB with a key derived from the validated salt; returns base64 without padding.", "scope": "", "scopeKind": ""}, {"name": "decryptTenantId(enc)", "description": "Decrypts an encrypted base64 string back to plaintext tenant ID using the same AES-128-ECB scheme.", "scope": "", "scopeKind": ""}, {"name": "setTenantEncryptionSalt()", "d