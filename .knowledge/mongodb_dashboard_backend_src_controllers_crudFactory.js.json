{"is_source_file": true, "format": "JavaScript", "description": "This file defines a factory function 'buildCrudController' that creates CRUD (Create, Read, Update, Delete) API controllers for a given Mongoose model. It includes utility functions for sorting, pagination, tenant filtering, error handling, and request timeout management, with specific support for models like 'LLMCost' and 'AppDeployment'. The generated controllers handle list retrieval with pagination, filtering, sorting, caching, and error mapping, as well as individual record access, creation, update, and removal, all while enforcing tenant access control and security measures.", "external_files": ["../utils/http"], "external_methods": ["parsePagination", "success", "failure", "withRequestTimeout"], "published": ["buildCrudController"], "classes": [], "methods": [{"name": "validateSort(sort, allowed = ['timestamp', 'created_at', '_id'])", "description": "Validates and sanitizes the sort string against allowed fields to prevent unindexed or heavy in-memory sorts.", "scope": "", "scopeKind": ""}, {"name": "clampLimit(limit, max = 200, defaultLimit = 25)", "description": "Enforces maximum page size limits for safety, with default and fallback limits.", "scope": "", "scopeKind": ""}, {"name": "microGet(key)", "description": "Retrieves a cached list response if available and not expired.", "scope": "", "scopeKind": ""}, {"name": "microSet(key, payload)", "description": "Stores a list response in in-memory cache with a TTL.", "scope": "", "scopeKind": ""}, {"name": "buildListKey(req, filter, sort, page, limit, skip, explicit)", "description": "Creates a stable cache key for list requests based on URL, path, and query parameters.", "scope": "", "scopeKind": ""}, {"name": "sanitizePayloadWithTenant(req)", "description": "Sanitizes incoming create/update payloads, removing client-supplied tenant fields and injecting tenantId from request context.", "scope": "", "scopeKind": ""}, {"name": "mergeFilterWithTena