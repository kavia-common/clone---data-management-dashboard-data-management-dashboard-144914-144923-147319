{
  "name": "minimal-express-app",
  "version": "1.0.0",
  "description": "Minimal Express app with scalable structure",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env HOST=0.0.0.0 NODE_OPTIONS=--max-old-space-size=3072 node src/server.js",
    "dev": "cross-env HOST=0.0.0.0 PORT=${PORT:-3001} NODE_ENV=development NODE_OPTIONS=--max-old-space-size=3072 BROWSERSLIST_DISABLE_CACHE=1 CHOKIDAR_USEPOLLING=false WATCHPACK_POLLING=false node src/server.js",
    "dev:nodemon": "cross-env HOST=0.0.0.0 PORT=${PORT:-3001} NODE_ENV=development NODE_OPTIONS=--max-old-space-size=3072 CHOKIDAR_USEPOLLING=false WATCHPACK_POLLING=false nodemon --exitcrash --watch src --ext js,json src/server.js",
    "preview": "cross-env HOST=0.0.0.0 NODE_OPTIONS=--max-old-space-size=3072 node src/server.js",
    "docs": "echo 'Swagger UI at http://localhost:3001/api-docs (alias: /docs)' && node -e \"console.log('OpenAPI JSON at /openapi.json')\"",
    "health": "curl -sSf http://127.0.0.1:${PORT:-3001}/health || true",
    "test": "cross-env CI=true NODE_ENV=test NODE_OPTIONS=--max-old-space-size=3072 jest --runInBand --ci --reporters=default",
    "lint": "eslint . || true",
    "lint:fix": "eslint . --fix || true",
    "browserslist:update": "npx update-browserslist-db@latest",
    "gen:openapi": "node generate_openapi.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "logs/**",
      ".tmp/**",
      "*.lock",
      "*.log",
      "*.md",
      "package.json",
      "package-lock.json",
      ".git/**"
    ],
    "ext": "js,json",
    "env": {
      "HOST": "0.0.0.0",
      "PORT": "3001",
      "NODE_ENV": "development",
      "CHOKIDAR_USEPOLLING": "false",
      "WATCHPACK_POLLING": "false"
    }
  }
}
