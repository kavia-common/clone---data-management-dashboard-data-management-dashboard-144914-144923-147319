{
  "name": "minimal-express-app",
  "version": "1.0.0",
  "description": "Minimal Express app with scalable structure",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development DISABLE_WATCH=0 nodemon --signal SIGTERM server.js",
    "start:lean": "cross-env NODE_ENV=production DISABLE_WATCH=1 node server.js",
    "start:ci": "cross-env NODE_ENV=production DISABLE_WATCH=1 node server.js",
    "docs": "echo 'Swagger UI at http://localhost:3001/api/docs (aliases: /docs, /api-docs)' && node -e \"console.log('OpenAPI JSON at /interfaces/openapi.json')\"",
    "health": "curl -sSf http://127.0.0.1:${PORT:-3001}/health || true",
    "test": "jest",
    "lint": "eslint .",
    "gen:openapi": "node generate_openapi.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4",
    "cross-env": "^7.0.3"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js"
    ],
    "ignore": [
      "node_modules",
      "package.json",
      "package-lock.json",
      "*.lock",
      "*.log",
      "*.md",
      ".git",
      "dist",
      "build",
      "coverage",
      "logs",
      "tmp",
      ".tmp"
    ],
    "ext": "js,json",
    "env": {
      "HOST": "0.0.0.0",
      "PORT": "3001",
      "NODE_ENV": "development"
    }
  }
}
