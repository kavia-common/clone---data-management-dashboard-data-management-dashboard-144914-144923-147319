{
  "name": "mongodb_dashboard_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express.js backend for the MongoDB dashboard application",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18 <21",
    "npm": ">=8"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json --exec node src/server.js",
    "lint": "eslint .",
    "postinstall": "node -e \"console.log('postinstall ok')\"",
    "health": "node -e \"import('./src/health-check.js').then(m=>m.default && m.default())\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.7"
  }
}
