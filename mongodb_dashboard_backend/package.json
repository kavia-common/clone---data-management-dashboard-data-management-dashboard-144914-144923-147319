{
  "name": "minimal-express-app",
  "version": "1.0.0",
  "description": "Minimal Express app with scalable structure",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_OPTIONS=--max_old_space_size=512 node src/server.js",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=1024 node src/server.js",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--max_old_space_size=512 BROWSERSLIST_DISABLE_CACHE=1 node src/server.js",
    "dev:watch": "cross-env NODE_ENV=development NODE_OPTIONS=--max_old_space_size=512 nodemon --exitcrash src/server.js",
    "dev:nodemon": "cross-env NODE_ENV=development NODE_OPTIONS=--max_old_space_size=512 nodemon --exitcrash src/server.js",
    "preview": "NODE_OPTIONS=--max_old_space_size=512 node src/server.js",
    "docs": "echo 'Swagger UI at http://localhost:3001/api-docs (alias: /docs)' && node -e \"console.log('OpenAPI JSON at /openapi.json')\"",
    "health": "curl -sSf http://127.0.0.1:${PORT:-3001}/health || true",
    "test": "cross-env CI=true NODE_ENV=test jest --runInBand --ci --reporters=default",
    "lint": "eslint . || true",
    "lint:fix": "eslint . --fix || true",
    "postinstall": "echo 'Skipping browserslist update for backend' && npx --yes update-browserslist-db@latest --no-funding --no-update-notifier || true",
    "gen:openapi": "node generate_openapi.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "node_modules",
      "package.json",
      "package-lock.json",
      "*.lock",
      "*.log",
      "*.md",
      ".git",
      "dist",
      "build"
    ],
    "ext": "js,json",
    "env": {
      "HOST": "0.0.0.0",
      "PORT": "3001",
      "NODE_ENV": "development"
    }
  }
}
