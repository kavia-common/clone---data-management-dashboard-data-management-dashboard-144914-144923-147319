{
  "environments": {
    "develop": "develop_kaviaroot",
    "qa": "qa_kaviaroot",
    "beta": "pre_prod__kaviaroot"
  },
  "collections": [
    {
      "dashboard": "Referral dashboard",
      "database": ["develop_kaviaroot", "qa_kaviaroot", "pre_prod__kaviaroot"],
      "name": "users",
      "fields": {
        "referral_code": { "type": "string", "description": "Used to onboard users through referrals." },
        "referral_stats": {
          "type": "object|array",
          "description": "List of objects containing referral statistics.",
          "properties": {
            "total_referrals": { "type": "number", "description": "Number of users onboarded based on the referral code" },
            "verified_referrals": { "type": "number", "description": "Number of users who have been verified." },
            "last_referral_date": { "type": "date|string", "format": "date-time", "description": "The most recent date a referral occurred." }
          }
        },
        "referral_history": {
          "type": "array",
          "description": "List of referral history objects containing detailed referral data.",
          "items": {
            "type": "object",
            "properties": {
              "user_id": { "type": "string|ObjectId", "description": "Unique identifier of the referred user." },
              "user_email": { "type": "string", "format": "email", "description": "Email address of the referred user." },
              "user_name": { "type": "string", "description": "Name of the referred user." },
              "referred_at": { "type": "date|string", "format": "date-time", "description": "Timestamp when the referral occurred." },
              "verified_at": { "type": "date|string|null", "format": "date-time", "description": "Timestamp when the referral was verified." },
              "status": { "type": "string", "enum": ["pending", "verified", "other"], "description": "Status of the referral." }
            },
            "required": ["user_id", "user_email", "user_name", "referred_at", "status"]
          }
        }
      },
      "suggestedIndexes": [
        { "keys": { "referral_code": 1 } },
        { "keys": { "referral_history.user_id": 1 } },
        { "keys": { "referral_history.status": 1, "referral_history.referred_at": -1 } }
      ]
    },
    {
      "dashboard": "Session dashboard",
      "database": ["develop_kaviaroot", "qa_kaviaroot", "pre_prod__kaviaroot"],
      "name": "session_tracking",
      "fields": {
        "task_id": { "type": "string", "description": "Value of the particular task." },
        "tenant_id": { "type": "string", "description": "The organization this session belongs to." },
        "organization_name": { "type": "string", "description": "Name of the organization." },
        "user_id": { "type": "string|ObjectId", "description": "Unique identifier of the user." },
        "user_name": { "type": "string", "alias": ["User_name"], "description": "Name of the user who performs the session." },
        "project_id": { "type": "string", "description": "The project ID associated with the session." },
        "container_id": { "type": "string", "description": "Indicates code generation or code maintenance session." },
        "service_type": { "type": "string", "enum": ["code generation", "code query", "deep query", "interactive configuration", "auto configuration", "code maintenance"], "description": "Type of service." },
        "session_start": { "type": "date|string", "format": "date-time", "description": "Timestamp when the session started." },
        "session_end": { "type": "date|string|null", "format": "date-time", "description": "Timestamp when the session ended." },
        "status": { "type": "string", "enum": ["active", "completed", "failed"], "description": "Status of the session." },
        "total_cost": { "type": "number", "description": "Sum of all agent costs." },
        "agent_costs": { "type": "object", "description": "Map of agents and their respective costs." },
        "cost_history": {
          "type": "array",
          "description": "Agent costs and total costs over time.",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": { "type": "date|string", "format": "date-time", "description": "Timestamp for this cost entry." },
              "agent_costs": { "type": "object", "description": "Costs for each agent at this timestamp." },
              "total_cost": { "type": "number", "description": "Total cost for this timestamp." }
            },
            "required": ["timestamp", "total_cost"]
          }
        },
        "last_updated": { "type": "date|string", "format": "date-time", "description": "Timestamp of the last update for this session." },
        "session_data": {
          "type": "object",
          "properties": {
            "llm_model": { "type": "string" },
            "session_name": { "type": "string" },
            "description": { "type": "string" },
            "platform": { "type": "string", "description": "e.g., web" },
            "selected_repos": {
              "type": "object",
              "properties": {
                "all_repositories": { "type": "boolean" },
                "repositories": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "created_at": { "type": "date|string", "format": "date-time", "description": "Timestamp when the session was created." }
      },
      "suggestedIndexes": [
        { "keys": { "tenant_id": 1, "status": 1, "session_start": -1 } },
        { "keys": { "user_id": 1, "session_start": -1 } },
        { "keys": { "project_id": 1, "service_type": 1 } },
        { "keys": { "task_id": 1 } },
        { "keys": { "last_updated": -1 } }
      ]
    },
    {
      "dashboard": "Deployment dashboard",
      "database": ["develop_kaviaroot", "qa_kaviaroot", "pre_prod__kaviaroot"],
      "name": "app_deployments",
      "fields": {
        "app_id": { "type": "string", "description": "Unique identifier for the deployed application." },
        "app_url": { "type": "string", "format": "uri", "description": "Publicly accessible URL of the deployed application." },
        "artifact_path": { "type": "string", "description": "Storage path or location of the deployment artifacts." },
        "branch_name": { "type": "string", "description": "The Git branch from which the deployment was created." },
        "build_path": { "type": "string", "description": "Path to the build directory containing compiled application files." },
        "command": { "type": "string", "description": "Build command executed for deployment." },
        "created_at": { "type": "date|string", "format": "date-time" },
        "custom_domain": { "type": "string|null" },
        "deployment_id": { "type": "string" },
        "job_id": { "type": "string" },
        "message": { "type": "string" },
        "project_id": { "type": "string" },
        "project_name": { "type": "string" },
        "root_path": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed", "in-progress"] },
        "subdomain": { "type": "string" },
        "task_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "tenant_name": { "type": "string" },
        "updated_at": { "type": "date|string", "format": "date-time" },
        "artifact_count": { "type": "number" },
        "domain_status": { "type": "string", "enum": ["verified", "pending", "failed"] },
        "domain_checked_at": { "type": "date|string|null", "format": "date-time" }
      },
      "required": ["deployment_id", "project_id", "status", "created_at"],
      "suggestedIndexes": [
        { "keys": { "project_id": 1, "created_at": -1 } },
        { "keys": { "tenant_id": 1, "status": 1, "updated_at": -1 } },
        { "keys": { "deployment_id": 1 }, "options": { "unique": true } },
        { "keys": { "app_id": 1, "updated_at": -1 } },
        { "keys": { "custom_domain": 1 }, "options": { "partialFilterExpression": { "custom_domain": { "$exists": true, "$ne": null } } } },
        { "keys": { "branch_name": 1, "created_at": -1 } }
      ]
    }
  ],
  "notes": {
    "pod_dashboard": "No MongoDB collection; maintained via Kubernetes API.",
    "naming": "Normalize field names (e.g., user_name vs User_name).",
    "timestamps": "Prefer MongoDB Date type.",
    "pii": "Consider field-level encryption for PII (emails)."
  }
}
