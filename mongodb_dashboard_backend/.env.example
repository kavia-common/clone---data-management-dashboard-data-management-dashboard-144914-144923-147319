# Backend Environment Example

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster-host>/?retryWrites=true&w=majority&appName=<appName>
# Explicit database (recommended)
# MONGODB_DB=develop_kaviaroot
# Enable index creation (optional; default is false)
# MONGOOSE_AUTO_INDEX=true

# CORS
# Allow any origin in development or if you set this to true.
# In production, prefer strict whitelisting below.
CORS_ALLOW_ALL=true
# If using strict mode (production), configure allowed origins:
# CORS_ORIGIN=https://app.example.com
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# FRONTEND_ORIGIN=https://app.example.com
# Enable credentialed requests if needed (cookies, auth)
# CORS_CREDENTIALS=true

# Frontend-derived API base (optional, helps infer origin in strict mode)
# REACT_APP_API_BASE_URL=https://api.example.com/api

# Rate limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
