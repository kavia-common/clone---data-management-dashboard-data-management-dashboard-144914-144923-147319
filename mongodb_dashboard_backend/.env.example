# Backend environment configuration (.env example)
# Copy this file to .env and adjust values for your environment.

# MongoDB connection string (MongoDB Atlas or standalone)
# Example: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=YourApp
MONGODB_URI=

# Explicit database name to use (recommended to avoid driver default "test")
# Common values based on environments in this project:
# - develop_kaviaroot
# - qa_kaviaroot
# - pre_prod__kaviaroot
MONGODB_DB=develop_kaviaroot

# Enable or disable Mongoose automatic index creation
# Default is disabled to avoid issues with existing data sets
MONGOOSE_AUTO_INDEX=false

# Logs an estimated document count for the session_tracking collection on startup
VERIFY_COLLECTIONS=false

# When true, the list endpoints will log the active db, collection, filter, and counts
DEBUG_DB_LOGS=false

# Override the collection name for session tracking if your dataset uses a different casing or name
# Default: session_tracking
SESSION_TRACKING_COLLECTION=session_tracking

# Optional: Swagger UI metadata
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# Server settings
PORT=3001
HOST=0.0.0.0
