# Backend environment example for MongoDB Dashboard (Express)

# MongoDB connection string (required in production)
# Example (SRV): mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority&appName=<app>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=MyApp

# Preferred database name environment variable
# If not set, the service will fall back to MONGODB_DB for backwards compatibility.
MONGODB_DB_NAME=my_dashboard_db

# Backwards-compatible database name (deprecated, use MONGODB_DB_NAME)
# MONGODB_DB=my_dashboard_db

# Optional: enable automatic index creation for Mongoose (disabled by default)
# MONGOOSE_AUTO_INDEX=true

# Swagger metadata overrides (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# CORS configuration (optional)
# CORS_ORIGIN=https://app.example.com
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_CREDENTIALS=true

# Frontend API base URL to help derive allowed origins (optional)
# REACT_APP_API_BASE_URL=http://localhost:3001/api
