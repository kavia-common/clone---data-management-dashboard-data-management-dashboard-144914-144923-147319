# Backend environment configuration for the dashboard backend

# MongoDB - provide your own URI or use the default baked-in cluster if omitted
# Example: mongodb+srv://<user>:<pass>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=

# Explicit database selection (recommended)
# For environments described in SCHEMA.md:
#   develop_kaviaroot, qa_kaviaroot, pre_prod__kaviaroot
MONGODB_DB=develop_kaviaroot

# Mongoose index creation is disabled by default to avoid issues on existing datasets
# Set to true only if you need models to auto-create indexes on startup.
MONGOOSE_AUTO_INDEX=false

# Service port/host
PORT=3001
HOST=0.0.0.0

# CORS settings for frontend
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
