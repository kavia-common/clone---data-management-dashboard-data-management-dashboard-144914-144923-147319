# Backend environment variables example (do not commit real secrets)
# Guards for /api/llm-costs
# Maximum allowed date window in days for GET /api/llm-costs. Requests exceeding this window are rejected with 400.
MAX_DAYS_WINDOW=90
# Default page limit (capped to 200) for GET /api/llm-costs when 'limit' is not provided.
DEFAULT_PAGE_LIMIT=50

# Optional diagnostics
# Set to '1' to include explain summaries and timing headers
DEBUG_LLMCOSTS_EXPLAIN=0
# Explain timeout in ms (keep small to avoid overhead)
DEBUG_LLMCOSTS_EXPLAIN_TIMEOUT_MS=600
