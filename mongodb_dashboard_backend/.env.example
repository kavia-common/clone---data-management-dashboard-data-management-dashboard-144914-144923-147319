# PUBLIC_INTERFACE
# Example environment variables for /api/llm-costs profiling and timeouts
# Set to 'true' to enable executionStats logging for /api/llm-costs page=1
LLM_COSTS_PROFILE=false
# Max time (ms) for the /api/llm-costs query and enrichment. Controller also applies per-operation maxTimeMS.
LLM_COSTS_QUERY_TIMEOUT_MS=8000
