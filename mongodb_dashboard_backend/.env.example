# Backend .env.example
# Copy to .env and adjust values for your environment. Do NOT commit secrets.

# Network
HOST=0.0.0.0
PORT=3001

# MongoDB
MONGODB_URI=
MONGODB_DB=dashboard

# Swagger UI branding (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# Performance & stability
# Cap Node heap to avoid OOM killer in constrained environments
# You set NODE_OPTIONS in npm scripts already; override here only if needed.
# NODE_OPTIONS=--max-old-space-size=384 --heapsnapshot-near-heap-limit=1

# Disable watchers in CI/preview
CI=true
DISABLE_WATCH=1
GENERATE_SOURCEMAP=false

# LLM Costs tuning
DEFAULT_PAGE_LIMIT=20
LLM_COSTS_ROUTE_TIMEOUT_MS=12000

# CORS
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_OPEN=true
