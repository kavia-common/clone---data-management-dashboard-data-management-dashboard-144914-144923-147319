# Backend configuration for local development or preview.
# IMPORTANT: Do not commit a real .env with secrets. This is only an example.

# The preview environment expects the app to bind to its assigned port.
# If your preview system sets PORT automatically, you do not need to change this.
# To run locally on a specific port, set PORT explicitly, e.g., 3001 or 3001.
PORT=3001
HOST=0.0.0.0

# MongoDB connection string (optional for boot; required for DB-backed endpoints)
# Example local connection:
# MONGODB_URI=mongodb://localhost:27017/dashboard_db
MONGODB_URI=

# CORS configuration (frontend origin)
# FRONTEND_ORIGIN=http://localhost:3000

# Swagger/OpenAPI customization (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_SERVER_URL=https://your-public-domain.example.com

# Feature flags
# ALLOW_DEV_ROUTES=true

# Auth related (demo)
# AUTH_JWT_SECRET=change_me
# AUTH_PASSWORD_PEPPER=use-a-strong-value
# SECRET_SALT=legacy-compat-if-needed
