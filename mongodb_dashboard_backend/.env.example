# Backend .env example for tenant-enforced JWT auth

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Mongo
MONGODB_URI=mongodb://localhost:27017/dashboard
MONGOOSE_AUTO_INDEX=false

# JWT verification (HS256 for local/dev; configure RS/JWKS externally if needed)
# Primary shared secret for HS256
JWT_SECRET=change_me_dev_only
# Optional aliases/fallbacks
JWT_HS256_SECRET=
# Optional issuer/audience checks (compatible with Cognito/OIDC)
COGNITO_ISSUER=
COGNITO_AUDIENCE=
JWT_ISSUER=
JWT_AUDIENCE=
# Token expiry for locally issued tokens (login endpoint)
JWT_EXPIRES_IN=1h

# CORS (optional)
FRONTEND_ORIGIN=http://localhost:3000

# Dev routes control
ALLOW_DEV_ROUTES=true
