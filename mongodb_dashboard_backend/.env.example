# Backend environment example (do not commit secrets)
# Copy to .env and fill in values as needed.

# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Mongo
# Set this to connect to a Mongo instance. If unset, server will still start without DB.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=dashboard_dev

# Swagger
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0

# Dev memory diagnostics (optional)
# DEBUG_MEMORY=true
# MAX_STARTUP_LOGS=2000

# Watcher behavior
CHOKIDAR_USEPOLLING=false
BROWSERSLIST_DISABLE_CACHE=1
