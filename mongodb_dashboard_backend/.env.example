# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB (optional for boot)
# MONGODB_URI=mongodb+srv://username:password@cluster/dbname
# MONGODB_DB=dashboard

# CORS
# FRONTEND_ORIGIN=https://your-frontend.example.com
# CORS_ORIGIN=https://another-origin.example.com
# CORS_ORIGINS=https://a.example.com,https://b.example.com
# CORS_CREDENTIALS=false

# Session Tracking Proxy
# Base URL of upstream API that serves /session-tracking (should include /api prefix if upstream expects it)
# Example: https://api.example.com/api
SESSION_TRACKING_UPSTREAM_BASE=http://localhost:3001/api

# Allow self-signed TLS for upstream (development only)
SESSION_TRACKING_UPSTREAM_INSECURE_TLS=false

# Optional static Authorization header for upstream, e.g., "Bearer <token>"
# If not set, proxy will forward client Authorization header when present.
# SESSION_TRACKING_UPSTREAM_AUTH=Bearer YOUR_TOKEN_HERE
