# Backend environment example

# Web server
PORT=3001
HOST=0.0.0.0

# MongoDB connection (required in non-local environments)
# Example Atlas: mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dashboard
# Optional: override db name when URI path doesn't include one
# MONGODB_DB=dashboard

# Mongoose tuning (optional)
# MONGOOSE_AUTO_INDEX=false
# MONGOOSE_MAX_POOL_SIZE=10
# MONGOOSE_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGOOSE_SOCKET_TIMEOUT_MS=45000

# DB connect retry policy
# DB_CONNECT_RETRIES=3
# DB_CONNECT_RETRY_DELAY_MS=1500

# CORS
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGIN=
# CORS_ORIGINS=
# CORS_CREDENTIALS=true
