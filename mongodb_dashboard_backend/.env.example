# Optional: MongoDB connection string. If not set, the server will still start and /health will report db=disconnected.
MONGODB_URI=mongodb://localhost:27017/dashboard

# Optional: override default database name selection logic (used for logging / helpers).
MONGODB_DB=dashboard

# Server bind configuration (preview expects PORT=3001 by default)
HOST=0.0.0.0
PORT=3001

# Optional: toggle response compression middleware
ENABLE_RESPONSE_COMPRESSION=true

# Optional: Swagger metadata overrides
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
