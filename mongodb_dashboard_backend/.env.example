# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB (optional for boot; required for DB-backed endpoints)
# Example: mongodb://user:pass@localhost:27017/dashboard
MONGODB_URI=

# Mongoose options
# Set to 'true' to enable autoIndex (disabled by default)
MONGOOSE_AUTO_INDEX=false

# CORS / Frontend origin
# Comma separated list of allowed origins
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ORIGINS=http://localhost:3000

# Swagger Docs
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
# Optional: override server URL shown in docs
# SWAGGER_SERVER_URL=https://your-backend.example.com

# Auth (demo)
AUTH_DEFAULT_TENANT=DEMO
# Optional salts/peppers (use strong values in production)
# SECRET_SALT=
# AUTH_TENANT_SALT=
# PASSWORD_SALT=
# AUTH_PASSWORD_PEPPER=
# AUTH_PEPPER=
# JWT config (if used by routes)
# JWT_SECRET=
# JWT_ISSUER=local-issuer
# JWT_AUDIENCE=local-audience
# JWT_EXPIRES_IN=1h
# JWT_ALG=HS256

# Dev routes
# Set to 'true' to force-enable /api/dev in production
# ALLOW_DEV_ROUTES=false

# Debugging
# DEBUG=true
