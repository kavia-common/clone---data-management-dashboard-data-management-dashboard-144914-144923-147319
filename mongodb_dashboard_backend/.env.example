# Backend environment example for timeouts and caching
HOST=0.0.0.0
PORT=3001

# Mongo (optional here for docs/health)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=test

# Request handling improvements
LLMCOSTS_MAX_PAGE_SIZE=200
MICRO_CACHE_TTL_MS=2000
LLMCOSTS_HIERARCHY_CACHE_TTL_MS=300000

# Server timeouts (ms)
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEPALIVE_TIMEOUT_MS=65000
SERVER_TIMEOUT_MS=60000
