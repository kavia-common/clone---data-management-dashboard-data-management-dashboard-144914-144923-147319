# Backend environment variables (example)

# HTTP port
PORT=3001

# Mongo connection handled by src/config/db.js (use existing config)
# MONGODB_URI=mongodb://...

# LLM Costs collection name (set to the actual collection with data)
LLMCOSTS_COLLECTION_NAME=llm_costs

# Pagination/window defaults
DEFAULT_PAGE_LIMIT=50
MAX_DAYS_WINDOW=90

# Enable periodic memory diagnostics (optional)
DEBUG_MEMORY_LOG=0
