# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
ALLOW_DEV_ROUTES=true

# MongoDB (provide a valid connection string in real environments)
# Example: mongodb://user:pass@mongo:27017/yourdb?authSource=admin
MONGODB_URI=
# Optional explicit database name override (if not provided, database in the URI is used)
MONGODB_DB=

# Mongoose tuning (optional)
# Set to 'true' to enable autoIndex creation; default is disabled.
MONGOOSE_AUTO_INDEX=false

# Swagger UI metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_SERVER_URL can override the server url in docs
# SWAGGER_SERVER_URL=https://your-domain.example.com

# Auth related (placeholder values, if applicable)
JWT_SECRET=
