# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Comma-separated list or * to allow all (backend uses single origin string)
# Example: http://localhost:3000
CORS_ORIGIN=*

# MongoDB
# Primary connection string (override the default in code)
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional database name to force a specific DB within the cluster
# Example: develop_kaviaroot
MONGODB_DB=

# Enable Mongoose autoIndex creation (default false to avoid index creation errors on existing datasets)
MONGOOSE_AUTO_INDEX=false

# Swagger UI metadata overrides (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
