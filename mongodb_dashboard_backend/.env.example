# Backend environment example (do not commit real secrets)
# Safe Mongo operation timeout in milliseconds. Default 12000 when not set.
SAFE_MAX_TIME_MS=12000
# Legacy alias still honored if present (SAFE_MAX_TIME_MS preferred)
# MAX_TIME_MS=12000

# Optional micro cache TTL in ms for list endpoints
# MICRO_CACHE_TTL_MS=2000

# Mongo connection string and DB name (example)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=dashboard
