# Backend environment configuration example

# PUBLIC_INTERFACE
# PORT the Express server listens on (defaults to 3001 if unset)
PORT=3001

# PUBLIC_INTERFACE
# Host interface to bind (0.0.0.0 binds all interfaces; recommended for containers)
HOST=0.0.0.0

# PUBLIC_INTERFACE
# Mongo connection string. If unset, the server still starts and /api/health reports db=disconnected.
# Example: mongodb://user:pass@localhost:27017/dashboard
MONGODB_URI=

# PUBLIC_INTERFACE
# Optional: override database name when connecting (some Mongo providers require db in URI instead)
# MONGODB_DB=dashboard

# PUBLIC_INTERFACE
# Optional: enable Mongoose autoIndex (off by default for performance/compatibility)
# MONGOOSE_AUTO_INDEX=true

# PUBLIC_INTERFACE
# Enable dev routes in production by setting true. In non-production, dev routes are enabled by default.
# ALLOW_DEV_ROUTES=false

# PUBLIC_INTERFACE
# CORS configuration
# FRONTEND_ORIGIN=https://localhost:3000
# CORS_ORIGIN=https://example.com
# CORS_ORIGINS=https://a.com,https://b.com
# CORS_CREDENTIALS=true

# PUBLIC_INTERFACE
# Swagger UI metadata
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_SERVER_URL=https://localhost:3001
