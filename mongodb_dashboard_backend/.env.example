# Backend environment example for mongodb_dashboard_backend

# MongoDB connection string (if not set, the service uses its built-in default URI)
# Note: It is recommended to provide this explicitly for production environments.
MONGODB_URI=

# Explicit database name selection (recommended). If omitted, the service falls back based on NODE_ENV:
# - development/dev/local/test -> develop_kaviaroot
# - qa/staging -> qa_kaviaroot
# - production/prod/beta/preprod/pre_prod/pre-prod -> pre_prod__kaviaroot
MONGODB_DB=develop_kaviaroot

# Enable/disable mongoose auto index creation (default: false)
MONGOOSE_AUTO_INDEX=false

# Optional: Verify certain collections on startup (logs estimated counts)
VERIFY_COLLECTIONS=false

# Server binding
HOST=0.0.0.0
PORT=3001

# CORS & Rate limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Swagger UI metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
SWAGGER_VERSION=1.0.0

# NODE_ENV influences dbName fallback if MONGODB_DB is not set
NODE_ENV=development
