# Backend API environment variables

# Server
PORT=3001
HOST=0.0.0.0

# Mongo
MONGODB_URI=mongodb://localhost:27017/dashboard
MONGOOSE_AUTO_INDEX=false

# Auth / JWT
# Prefer RS256 with public key when available:
# Paste PEM public key or provide file path via JWT_PUBLIC_KEY_FILE
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# Fallback HS256 secret (development/demo)
JWT_SECRET=change_me_dev_only

# Optional issuer/audience validation
JWT_ISSUER=
JWT_AUDIENCE=
COGNITO_ISSUER=
COGNITO_AUDIENCE=

# Session (for cookie-based login persistence)
SESSION_SECRET=replace_with_strong_random

# Swagger
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
SWAGGER_VERSION=1.0.0
SWAGGER_SERVER_URL=
