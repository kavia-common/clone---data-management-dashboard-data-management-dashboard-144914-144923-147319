# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS / Frontend origin configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# Optional single origin override
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB
# Provide your MongoDB connection string. If left empty, the server still starts
# and health endpoints will indicate db = disconnected.
MONGODB_URI=mongodb://localhost:27017/dashboard

# Auth / security
# Use strong random values in non-development environments.
AUTH_JWT_SECRET=change-me-in-production
AUTH_PASSWORD_PEPPER=
SECRET_SALT=development-only-salt
AUTH_TENANT_SALT=

# Swagger
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
# Optionally set your public server URL for docs
# SWAGGER_SERVER_URL=http://localhost:3001

# Development routes
# Set to true to force-enable /api/dev routes in production-like environments
# ALLOW_DEV_ROUTES=true

# Logging
# DEBUG=true
