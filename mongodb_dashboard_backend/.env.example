# Server
PORT=3001
NODE_ENV=development

# MongoDB
# MONGODB_URI=<your-mongodb-uri>
# MONGODB_DB=<db-name>
# MONGOOSE_AUTO_INDEX=false

# Swagger (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard

# CORS configuration
# CORS_ORIGIN=https://app.example.com
# CORS_ORIGINS=https://app1.example.com,https://app2.example.com
# REACT_APP_API_BASE_URL=http://localhost:3001/api
# CORS_CREDENTIALS=true

# Authentication / Tenant resolution
# PUBLIC_INTERFACE
# AUTH_TENANT_SALT must be a non-placeholder value >= 12 chars; otherwise /api/auth/login returns 400.
AUTH_TENANT_SALT=change-this-to-a-long-random-salt

# Optional legacy/compat
# AUTH_PASSWORD_SALT=
# QA_SALT=
# JWT secret for real JWT signing if implemented
# AUTH_JWT_SECRET=

# Tenant strategy and mapping
# One of: body, host, body-or-host, host-or-body. Default is body-or-host.
AUTH_TENANT_STRATEGY=body-or-host

# Default tenant when none can be derived from request
AUTH_DEFAULT_TENANT=qa

# Allowlist of expected tenants (CSV). If set, only these are accepted.
# AUTH_EXPECTED_TENANTS=qa,staging,prod

# JSON mapping of tenant_id -> credentials/metadata (stringified JSON).
# If present, only tenants present as keys are accepted.
# Example: {"qa":{"poolId":"us-east-1_abc","clientId":"123"},"prod":{"poolId":"us-east-1_def","clientId":"456"}}
# AUTH_TENANT_MAPPING={"qa":{"note":"example"},"prod":{"note":"example"}}
