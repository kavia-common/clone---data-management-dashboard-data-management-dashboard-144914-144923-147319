# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGODB_URI=
MONGOOSE_AUTO_INDEX=false

# JWT (HS256 by default)
# REQUIRED for production; dev falls back to 'dev-secret' if unset.
JWT_SECRET=change_me_dev_only

# Optional issuer/audience checks
JWT_ISSUER=
JWT_AUDIENCE=
COGNITO_ISSUER=
COGNITO_AUDIENCE=

# Token expiry (used by login route when issuing demo tokens)
JWT_EXPIRES_IN=1h

# CORS/Docs (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
SWAGGER_VERSION=1.0.0
SWAGGER_SERVER_URL=
