# Backend service configuration

# The MongoDB connection URI. Provide your cluster or local MongoDB URI here.
# Example (local): mongodb://localhost:27017
# Example (Atlas): mongodb+srv://<user>:<pass>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Explicit database name override. If not set, MongoDB will use the db from the URI or a default.
# Example: develop_kaviaroot / qa_kaviaroot / pre_prod__kaviaroot
MONGODB_DB=

# Optional: Create indexes automatically (default is false to avoid failures on existing datasets)
MONGOOSE_AUTO_INDEX=false

# Server binding
PORT=3001
HOST=0.0.0.0

# Swagger UI metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# CORS settings
# Single allowed origin:
# CORS_ORIGIN=https://your-frontend.example.com
# OR multiple origins (comma-separated):
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Allow credentials (if frontend uses withCredentials or fetch credentials: 'include')
CORS_CREDENTIALS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
