# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Mongo
MONGODB_URI=mongodb://localhost:27017/develop_kaviaroot

# Auth
JWT_SECRET=change_me_to_a_very_long_random_string
JWT_EXPIRES_IN=1d
PASSWORD_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Swagger
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Dashboard backed by MongoDB
