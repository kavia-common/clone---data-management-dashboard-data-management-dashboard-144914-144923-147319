# Backend server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB (optional for startup)
# Provide a valid connection string to enable DB-backed endpoints
# MONGODB_URI=mongodb://user:pass@host:27017/dbname
# MONGODB_DB=test
# MONGOOSE_AUTO_INDEX=false

# Swagger
# SWAGGER_TITLE=Dashboard API
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_VERSION=1.0.0

# CORS
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# CORS_CREDENTIALS=false
# CORS_OPEN=false

# Auth (demo)
# JWT_SECRET=changeme
# JWT_ISSUER=local-issuer
# JWT_AUDIENCE=local-audience
# JWT_EXPIRES_IN=1h
# AUTH_DEFAULT_TENANT=DEMO
# ALLOWED_TENANTS=
