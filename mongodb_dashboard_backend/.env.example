# Server configuration
# HOST should be 0.0.0.0 in containerized/preview environments so the service is reachable externally.
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB configuration
# IMPORTANT: Do not commit your real credentials. Copy this file to .env and fill in MONGODB_URI for local/dev usage.
# If MONGODB_URI is absent, the server will still start and health will indicate db=disconnected.
# Example (Atlas): mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=MyApp
MONGODB_URI=
# Optional: Explicit DB name (defaults to the db from URI path; our code defaults to "test" when unspecified).
MONGODB_DB=test
# Enable autoIndex if you need Mongoose to build indices automatically in dev (disabled by default for safety).
MONGOOSE_AUTO_INDEX=false

# Security/Docs related environment variables
# Customize Swagger title/description if desired.
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
SWAGGER_VERSION=1.0.0

# Debug
# DEBUG=true
