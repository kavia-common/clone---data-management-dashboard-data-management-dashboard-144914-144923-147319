# Backend environment example

# Server
HOST=0.0.0.0
PORT=3001

# Mongo
MONGODB_URI=mongodb://localhost:27017/dashboard
MONGOOSE_AUTO_INDEX=false

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# JWT configuration (HS256 by default)
# REQUIRED in production
JWT_SECRET=change_me_dev_only

# Optional audience/issuer checks (leave empty to disable)
JWT_AUDIENCE=
JWT_ISSUER=
# Cognito-compatible aliases if using Cognito
COGNITO_AUDIENCE=
COGNITO_ISSUER=

# Swagger (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
SWAGGER_VERSION=1.0.0
SWAGGER_SERVER_URL=http://localhost:3001
