# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# CORS
# Single origin to allow (e.g., frontend)
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# Whether to allow credentials
CORS_CREDENTIALS=false
# If your frontend defines the API base URL, we use its origin for CORS infer
REACT_APP_API_BASE_URL=http://localhost:3001/api

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_SKIP_GET=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dashboard

