# Backend environment variables (copy to .env and adjust values)
HOST=0.0.0.0
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=test

# Swagger (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
SWAGGER_VERSION=1.0.0

# CORS (optional)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://your-preview-host
# CORS_CREDENTIALS=false
