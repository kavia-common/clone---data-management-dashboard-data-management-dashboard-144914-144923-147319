# Backend environment example (do not commit secrets)

# Network
HOST=0.0.0.0
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/test
MONGODB_DB=test

# Swagger docs (optional overrides)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# CORS
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://example.com
# CORS_CREDENTIALS=false
# CORS_OPEN=false

# Security
# JWT_SECRET=changeme
# PEPPER=optional-global-pepper

# Watch / Dev
# Use NODE_OPTIONS in npm scripts to cap memory and tune GC; override if needed:
# NODE_OPTIONS="--max_old_space_size=512 --heapsnapshot-near-heap-limit=1 --max_semi_space_size=32"

# Misc
NODE_ENV=development
