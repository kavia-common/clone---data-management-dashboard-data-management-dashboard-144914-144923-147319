# MongoDB
MONGODB_URI=
# Optional explicit database name
MONGODB_DB=
# Enable automatic index creation (default false)
MONGOOSE_AUTO_INDEX=false

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS configuration
# Single origin (exact match)
# CORS_ORIGIN=https://your-frontend.example.com
# Multiple origins (comma-separated)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Allow cookies/credentials if your frontend uses withCredentials: true
CORS_CREDENTIALS=false

# If your frontend supplies REACT_APP_API_BASE_URL (common in React apps),
# the backend will auto-derive and allow that origin for CORS.
# Example (hosted): https://api.example.com/api  -> allows https://app.example.com
# Example (local dev): http://localhost:3001/api -> allows http://localhost:3000
# Set this in the frontend .env, not required in the backend env for localhost,
# but you can set it here if your tooling requires it for derived allow-list.
REACT_APP_API_BASE_URL=http://localhost:3001/api

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
