# Backend .env example for mongodb_dashboard_backend

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
# IMPORTANT: Provide a valid MongoDB connection string to enable DB-backed features.
# Example local connection (adjust as needed):
# MONGODB_URI=mongodb://localhost:27017/dashboard
MONGODB_URI=
# Optional database override (otherwise taken from URI path)
# MONGODB_DB=dashboard
# Optional: set to 'true' to enable autoIndex creation (default: disabled)
# MONGOOSE_AUTO_INDEX=false

# Swagger docs (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_SERVER_URL=http://localhost:3001

# CORS (optional)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
