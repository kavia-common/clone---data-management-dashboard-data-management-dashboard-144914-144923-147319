# Backend environment variables example
# Copy to .env and adjust for your environment.

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
# REQUIRED: Connection string to MongoDB
MONGODB_URI=mongodb://mongodb_dashboard_db:27017/dashboard
# Optional DB name if not embedded in URI path
# MONGODB_DB=dashboard

# Startup behavior: if true, server will exit when DB is not reachable at startup
STARTUP_REQUIRE_DB=false

# Mongoose options
MONGOOSE_AUTO_INDEX=false
MONGO_MAX_RETRIES=5
MONGO_BASE_DELAY_MS=500
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL=10

# CORS
CORS_ORIGINS=
CORS_ORIGIN=
FRONTEND_ORIGIN=
CORS_CREDENTIALS=true

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
