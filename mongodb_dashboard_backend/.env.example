# Backend server
PORT=3001
HOST=0.0.0.0

# MongoDB connection (required at runtime)
MONGODB_URI=mongodb://username:password@host:27017/yourdb?authSource=admin

# Swagger / Docs metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# CORS configuration
# Set your frontend's origin(s) to allow requests. You can use either a single origin or a CSV list.
# Examples:
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://your-frontend.example.com
# CORS_ORIGINS=https://your-frontend.example.com,https://staging-frontend.example.com
FRONTEND_ORIGIN=http://localhost:3000
# Allow cookies/credentials if your app uses them
CORS_CREDENTIALS=true

# Optional: The React app may set REACT_APP_API_BASE_URL; the backend will infer and allow its origin automatically.
# REACT_APP_API_BASE_URL=http://localhost:3001/api
