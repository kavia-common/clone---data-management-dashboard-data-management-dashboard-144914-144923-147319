# Backend environment example for mongodb_dashboard_backend

# Always bind to 0.0.0.0 in containers/preview to avoid EADDRNOTAVAIL
HOST=0.0.0.0
PORT=3001

# Mongo connection (optional for basic startup; health/docs work without it)
# MONGODB_URI=mongodb://user:pass@host:27017/yourdb
# MONGODB_DB=yourdb
# MONGOOSE_AUTO_INDEX=false

# Swagger UI metadata (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_VERSION=1.0.0

# Logging/debug flags
# DEBUG=false
# NODE_ENV=development

# CORS options (optional)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
# CORS_CREDENTIALS=false
