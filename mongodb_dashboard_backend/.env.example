# Backend environment example

# Server
PORT=3001
NODE_ENV=development

# MongoDB connection (example)
# MONGODB_URI=mongodb://localhost:27017/dashboard

# Swagger metadata (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# -----------------------------------------------------------------------------
# CORS configuration
# -----------------------------------------------------------------------------
# Preferred: restrict the allowed frontend origin explicitly.
# Example for local React dev server:
FRONTEND_ORIGIN=http://localhost:3000

# Alternatively, you can use one of the following:
# CORS_ORIGIN=https://frontend.example.com
# CORS_ORIGINS=https://one.example.com,https://two.example.com

# When using a full API base URL in frontend builds, we can infer origin:
# REACT_APP_API_BASE_URL=https://api.example.com

# Allow credentialed requests (cookies/authorization across origins)
# Set to "true" only if needed and safe in your deployment.
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Rate limits (optional)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_SKIP_GET=true
