# Backend environment example - do NOT commit real secrets
# Note: The CI/deployment layer will map actual values to .env; this file documents required/optional vars.

# Pagination defaults for list endpoints
# Maximum page size enforced server-side for /api/llm-costs (and other lists)
# limit must be <= 200; when not provided or invalid, DEFAULT_PAGE_LIMIT is applied (clamped to <= 200)
DEFAULT_PAGE_LIMIT=50

# Maximum allowed date window, in days, for GET /api/llm-costs when:
# - from/to are both missing (default window is applied ending at now)
# - only one bound is provided (the other is clamped so the window does not exceed this)
# - both are provided and exceed this window (request is rejected with 400)
MAX_DAYS_WINDOW=90

# Diagnostics toggles for /api/llm-costs (optional; keep disabled in production)
# When set to 1, server will attempt to capture explain() summaries and add debug metadata.
#DEBUG_LLMCOSTS_EXPLAIN=1
#DEBUG_LLMCOSTS_EXPLAIN_TIMEOUT_MS=600
