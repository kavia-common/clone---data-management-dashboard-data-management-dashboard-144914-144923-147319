# Backend server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS configuration
# Optional explicit origins (comma separated)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# If your frontend runs elsewhere, set FRONTEND_ORIGIN to that origin (scheme://host[:port])
# FRONTEND_ORIGIN=
# Allow sending credentials (cookies/auth) across origins; default is false
# CORS_CREDENTIALS=false

# Upstream configuration for /api/proxy/session-tracking
# Base URL of the upstream service that serves /session-tracking
# Example: https://your-upstream-host:3001/api
SESSION_TRACKING_UPSTREAM_BASE=http://localhost:3001/api

# If upstream uses a self-signed certificate in development, set to true
# WARNING: Development only. Do not enable in production.
SESSION_TRACKING_UPSTREAM_INSECURE_TLS=false

# Compatibility fallbacks (used if SESSION_TRACKING_UPSTREAM_BASE is not set)
# REACT_APP_BACKEND_URL can also point to http(s)://host:port/api
# REACT_APP_BACKEND_URL=
