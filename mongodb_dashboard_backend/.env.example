# Example environment variables for mongodb_dashboard_backend

# Server
HOST=0.0.0.0
PORT=3001

# Server/Request timeouts (in milliseconds)
# Node HTTP server timeouts used to mitigate 504s
# Overall request timeout
SERVER_REQUEST_TIMEOUT_MS=120000
# Time allowed to receive headers
SERVER_HEADERS_TIMEOUT_MS=125000
# Keep-alive timeout between requests
SERVER_KEEPALIVE_TIMEOUT_MS=65000
# Optional express per-route timeout via req.setTimeout (0 disables)
EXPRESS_ROUTE_TIMEOUT_MS=0

# MongoDB
# MONGODB_URI=mongodb://user:password@host:27017/dbname

# Auth
# JWT_SECRET=replace-with-strong-secret
# COGNITO_JWKS_URL=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json

# Misc
# NODE_ENV=production
