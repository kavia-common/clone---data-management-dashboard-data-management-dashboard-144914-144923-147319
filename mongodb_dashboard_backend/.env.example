# Backend API environment example

PORT=3001
MONGODB_URI=mongodb://localhost:27017/dashboard

# JWT / Auth settings
# Preferred: use JWKS URL provided by your IdP (e.g., Cognito, Auth0)
AUTH_JWKS_URL=
COGNITO_JWKS_URL=
# Alternative HMAC secret for HS256 (avoid in production if using external IdP)
AUTH_JWT_SECRET=

# Development only: allow decoding JWTs without signature verification (extracts claims only)
# WARNING: Set to 'true' ONLY in local dev.
ALLOW_INSECURE_JWT_DECODE=false

# CORS/frontend hints
FRONTEND_ORIGIN=http://localhost:3000
SWAGGER_TITLE=Dashboard API
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
