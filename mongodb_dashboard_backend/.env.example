# Backend server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB connection (required)
# Example for local MongoDB: mongodb://127.0.0.1:27017/dashboard
# Example for Atlas: mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Optional explicit DB name override (if not already in URI path)
# MONGODB_DB=dashboard

# Mongoose options
# Set to 'true' to enable autoIndex; defaults to disabled for safer prod defaults
MONGOOSE_AUTO_INDEX=false

# Enable dev-only routes in production (default off)
# Set to 'true' to mount /api/dev/* even when NODE_ENV=production
ALLOW_DEV_ROUTES=false

# Swagger customization (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express

# Micro-cache TTL for list endpoints (ms)
MICRO_CACHE_TTL_MS=2000
