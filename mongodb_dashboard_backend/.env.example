# Backend environment configuration for mongodb_dashboard_backend

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/dashboard

# Auth configuration
# Strong secret used for signing JWTs (when JWT-based auth is enabled)
AUTH_JWT_SECRET=please-change-this-to-a-long-random-secret

# Salt used for tenant/org encryption/validation. Must be >= 12 chars and non-placeholder.
AUTH_TENANT_SALT=please-change-this-strong-salt-value

# Optional legacy compatibility: uncomment if some flows reference these
# PASSWORD_SALT=
# QA_SALT=

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
