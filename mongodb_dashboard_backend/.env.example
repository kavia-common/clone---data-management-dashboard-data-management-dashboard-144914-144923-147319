# Example environment for mongodb_dashboard_backend

# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Preferred: single MongoDB connection string (use docker service name for host)
# For docker-compose, the Mongo service is typically reachable via its service name:
# e.g., mongodb_dashboard_db
# MONGODB_URI takes precedence over other vars below.
MONGODB_URI=mongodb://mongodb_dashboard_db:27017/dashboard?retryWrites=true&authSource=admin

# Alternative: if MONGODB_URI is not provided, the backend composes one from below:
MONGODB_HOST=mongodb_dashboard_db
MONGODB_PORT=27017
MONGODB_DB=dashboard
# If auth enabled, set user/password and authSource appropriately:
# MONGODB_USER=appuser
# MONGODB_PASSWORD=apppass
# MONGODB_AUTHSOURCE=admin

# Optional tuning (defaults applied if unset)
MONGOOSE_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_RETRIES=4
MONGODB_CONNECT_RETRY_DELAY_MS=1000

# Swagger metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
