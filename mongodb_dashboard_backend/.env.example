# Backend environment example (do not commit real secrets)
HOST=0.0.0.0
PORT=3001

# MongoDB connection
# MONGODB_URI=mongodb://user:pass@host:27017/db
MONGODB_DB=test
MONGOOSE_AUTO_INDEX=false

# Logging and diagnostics
# Reduce chance of noisy logs causing memory growth in CI/dev
MAX_STARTUP_LOGS=1000
# Enable lightweight memory snapshot on boot
# DEBUG_MEMORY=true

# Node options are set by package.json scripts; override here only if needed
# NODE_OPTIONS=--max-old-space-size=640
