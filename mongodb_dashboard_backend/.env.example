# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/dashboard

# JWT and security (example placeholders)
JWT_SECRET=change_me
RATE_LIMIT_MAX=200

# Swagger UI
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0

# Optional: override LLM costs collection name (default: llm_costs)
LLMCOSTS_COLLECTION_NAME=llm_costs

# Compression
ENABLE_RESPONSE_COMPRESSION=true
