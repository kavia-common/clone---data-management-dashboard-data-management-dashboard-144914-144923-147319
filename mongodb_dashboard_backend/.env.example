# Backend environment variables (example)
# CORS configuration:
# Single allowed origin:
# CORS_ORIGIN=http://localhost:3000
# Or multiple origins (comma-separated):
# CORS_ORIGINS=http://localhost:3000,https://localhost:3000
# If your frontend is on a preview URL, include it here:
# FRONTEND_ORIGIN=https://<your-frontend-host>:3000
# If your deployment uses REACT_APP_API_BASE_URL for the frontend, backend will infer and allow its origin automatically.

# Allow credentialed requests (cookies, Authorization, etc.)
# CORS_CREDENTIALS=false

# Swagger UI
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0

# Database, etc. (fill according to your setup)
# MONGODB_URI=mongodb://localhost:27017/dashboard
