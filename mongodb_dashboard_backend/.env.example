# JWT / Cognito configuration (set by orchestrator; do not commit real secrets)
JWT_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json
JWT_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
JWT_AUDIENCE=<app-client-id>

# For local/dev token signing (fallback when not using JWKS)
JWT_HS256_SECRET=replace-with-dev-secret
JWT_SECRET=${JWT_HS256_SECRET}
JWT_EXPIRES_IN=1h

# Header configuration (optional)
JWT_HEADER=Authorization
JWT_SCHEME=Bearer
