# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
# MONGODB_DB=develop_kaviaroot
# MONGOOSE_AUTO_INDEX=true

# CORS
# You can set a single origin:
# CORS_ORIGIN=https://your-frontend.example.com
# Or a comma-separated whitelist:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Enable credentials (cookies/Authorization headers across origins) if needed:
# CORS_CREDENTIALS=true

# Defaults (used when not set):
# - If CORS_ORIGIN and CORS_ORIGINS are not set, defaults to:
#   https://vscode-internal-28199-beta.beta01.cloud.kavia.ai:4000

# Swagger (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
