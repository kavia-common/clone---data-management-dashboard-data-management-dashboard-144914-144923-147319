# Express server configuration
# Host interface to bind to. Use 0.0.0.0 to accept external connections (preview environments).
HOST=0.0.0.0

# Port for the backend service. Preview expects 3001 by default.
PORT=3001

# MongoDB connection string.
# Leave empty to start the server without DB (health endpoints will report db=disconnected).
# For local MongoDB, uncomment and set accordingly:
# MONGODB_URI=mongodb://localhost:27017/dashboard

# Optional: override database name selection for Mongoose (defaults handled in code)
# MONGODB_DB=dashboard

# Optional: enable autoIndex creation in Mongoose (not recommended in production)
# MONGOOSE_AUTO_INDEX=false

# Swagger/OpenAPI optional customizations
# SWAGGER_TITLE=Dashboard API
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_VERSION=1.0.0

# CORS configuration (see README for details)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS_CREDENTIALS=false

# Development flags
# DEBUG=false
# NODE_ENV=development
