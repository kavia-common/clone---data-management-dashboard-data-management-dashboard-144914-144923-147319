# Backend environment variables (example)
# Copy to .env and fill values for local development.

# Required: Mongo connection string
MONGODB_URI=mongodb://localhost:27017/my_db

# Optional: override DB name (otherwise taken from MONGODB_URI path)
# MONGODB_DB=my_db

# Server binding
PORT=3001
HOST=0.0.0.0

# Optional tuning
# MONGOOSE_AUTO_INDEX=false
# ENABLE_RESPONSE_COMPRESSION=true
