# Server binding (defaults match preview expectations)
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB connection (optional for boot)
# When not set, server still starts and health shows db=disconnected
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=dashboard

# CORS/Docs (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard
# SWAGGER_VERSION=1.0.0
