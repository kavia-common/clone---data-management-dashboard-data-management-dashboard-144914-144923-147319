# Backend environment configuration example

# MongoDB connection string (SRV or standard). If not set, code falls back to a built-in default for demo purposes.
# Prefer providing your own connection string for production/staging environments.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority

# Optional: Explicit database name to select (overrides db in URI if set)
# MONGODB_DB=develop_kaviaroot

# Optional: Enable automatic index creation (defaults to false)
# MONGOOSE_AUTO_INDEX=true

# Server host/port
# HOST=0.0.0.0
# PORT=3001

# CORS
# CORS_ORIGIN=*

# Swagger metadata (optional)
# SWAGGER_TITLE=Dashboard API
# SWAGGER_VERSION=1.0.0
# SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
