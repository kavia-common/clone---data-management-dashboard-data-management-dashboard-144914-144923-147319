# Backend environment configuration
# Copy this file to .env and fill in real values. Do NOT commit .env with secrets.

# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB (required for DB-backed endpoints)
# Example URI:
# mongodb://user:password@localhost:27017/mydb?authSource=admin
# or mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mydb
MONGODB_URI=
# Optional explicit database name override. If unset, Mongo will use DB from URI path.
MONGODB_DB=

# Mongoose
# Enable only if you want Mongoose to create indexes automatically.
MONGOOSE_AUTO_INDEX=false

# CORS (optional)
FRONTEND_ORIGIN=http://localhost:3000
CORS_OPEN=false
CORS_CREDENTIALS=false

# Swagger (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
