# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb://user:pass@host:27017/dbname
# MONGOOSE_AUTO_INDEX=false

# Swagger / Docs metadata (optional)
SWAGGER_TITLE=Dashboard API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=REST API for Data Management Dashboard with MongoDB and Express
# SWAGGER_SERVER_URL=http://localhost:3001

# CORS (optional)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Authentication / JWT
# HS256 secret for verifying id_token Authorization: Bearer <token>
JWT_SECRET=change_me_dev_only
# Optional issuer/audience checks (Cognito-compatible)
# COGNITO_ISSUER=
# COGNITO_AUDIENCE=
# JWT_ISSUER=
# JWT_AUDIENCE=
# Local token issuance (auth.login) TTL
JWT_EXPIRES_IN=1h

# Dev routes control
# ALLOW_DEV_ROUTES=true
