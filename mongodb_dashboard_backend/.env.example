# Backend environment example for development
# PUBLIC_INTERFACE
# SECRET_SALT is the single source of truth for tenant encryption and token signing helpers.
# Format: URL-safe base64 (base64url) without '=' padding, typically 22-24 chars.
# Example: g5StFHvCyj0Hf9g8j87nGA
# Generate with Node:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
SECRET_SALT=g5StFHvCyj0Hf9g8j87nGA

# Optional legacy variables (will be ignored if SECRET_SALT is set)
# AUTH_TENANT_SALT=
# QA_SALT=
# PASSWORD_SALT=

# JWT secret if using JWT issuance (separate from SECRET_SALT if desired)
# AUTH_JWT_SECRET=

# Tenant resolver strategy: body | host | body-or-host | host-or-body
AUTH_TENANT_STRATEGY=body-or-host

# Default tenant if not resolvable
AUTH_DEFAULT_TENANT=default

# Allowed tenants (CSV) or mapping (JSON). If both absent, any non-empty tenant is allowed.
# AUTH_EXPECTED_TENANTS=org1,org2
# AUTH_TENANT_MAPPING={"org1": {"name":"Org 1"}}
