{
  "watch": ["src/server.js", "src/app.js"],
  "ignore": [
    "node_modules",
    "package.json",
    "package-lock.json",
    "*.lock",
    "*.log",
    "*.md",
    ".git",
    "dist",
    "build",
    "coverage",
    ".tmp",
    "**/__tests__/**",
    "kavia-docs",
    "interfaces",
    "**/*.test.js",
    "src/utils/**",
    "src/services/**",
    "src/models/**",
    "src/controllers/**",
    "src/middleware/**"
  ],
  "ext": "js json",
  "delay": "2000",
  "verbose": false,
  "legacyWatch": true,
  "signal": "SIGTERM",
  "env": {
    "HOST": "0.0.0.0",
    "PORT": "3001",
    "NODE_ENV": "development",
    "BACKEND_DEBUG_ONCE": "false",
    "KEEPALIVE_INTERVAL_MS": "30000",
    "BROWSERSLIST_DISABLE_CACHE": "1",
    "DISABLE_OPENCOLLECTIVE": "true",
    "npm_config_loglevel": "warn",
    "NODE_OPTIONS": "--max-old-space-size=2048 --heapsnapshot-near-heap-limit=1 --no-concurrent-array-buffer-freeing",
    "NODE_ENV_DISABLE_SOURCE_MAPS": "1"
  },
  "events": {
    "restart": "echo '[nodemon] Restarting server due to changes...'"
  }
}
