{
  "watch": ["src", "swagger.js"],
  "ignore": [
    "node_modules",
    "package.json",
    "package-lock.json",
    "*.lock",
    "*.log",
    "*.md",
    ".git",
    "dist",
    "build",
    "coverage",
    ".tmp",
    "**/__tests__/**",
    "kavia-docs",
    "interfaces"
  ],
  "ext": "js json",
  "delay": "2000",
  "verbose": false,
  "legacyWatch": true,
  "env": {
    "HOST": "0.0.0.0",
    "PORT": "3001",
    "NODE_ENV": "development",
    "BACKEND_DEBUG_ONCE": "false"
  },
  "events": {
    "restart": "echo '[nodemon] Restarting server due to changes...'"
  }
}
