# Frontend environment variables (DO NOT COMMIT .env)
# Set the backend API base URL for the React app. Example:
# REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_API_BASE_URL=

# Optional: backend API prefix (default: /api)
REACT_APP_API_PREFIX=/api

# Optional: backend port used if API_BASE_URL is not set (default: 3001)
REACT_APP_BACKEND_PORT=3001
