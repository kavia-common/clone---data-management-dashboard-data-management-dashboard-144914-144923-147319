# Frontend environment variables
# PUBLIC_INTERFACE
# REACT_APP_SECRET_SALT is used as the literal organization_id in login payloads.
# Must be a URL-safe base64-like string without padding (no '='). Example below matches acceptance criteria.
REACT_APP_SECRET_SALT=g5StFHvCyj0Hf9g8j87nGA

# Optional: override API base URL (defaults to https://kaviaqa-worktool.cloud.kavia.ai for auth endpoints)
REACT_APP_API_BASE_URL=https://kaviaqa-worktool.cloud.kavia.ai
