# Frontend environment variables for MongoDB Dashboard Frontend (React)
# Copy this file to `.env` and adjust values per environment.
#
# IMPORTANT: For the Kavia preview environment, set the backend to the exact origin below.
# This ensures all Swagger endpoints are called at:
# https://vscode-internal-14377-beta.beta01.cloud.kavia.ai:3001/api

# PUBLIC_INTERFACE
# Backend API origin (protocol + host + port; no trailing /api here)
REACT_APP_API_BASE_URL=https://vscode-internal-14377-beta.beta01.cloud.kavia.ai:3001

# PUBLIC_INTERFACE
# API prefix used by backend routes (kept as /api)
REACT_APP_API_PREFIX=/api

# Optional: if you prefer using REACT_APP_API_URL instead of REACT_APP_API_BASE_URL
# REACT_APP_API_URL=https://vscode-internal-14377-beta.beta01.cloud.kavia.ai:3001

# Optional fallback port when auto-inferring (e.g., local development)
REACT_APP_BACKEND_PORT=3001
