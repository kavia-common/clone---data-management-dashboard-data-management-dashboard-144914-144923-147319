# React Frontend Environment Variables for MongoDB Dashboard

# Base URL of the backend API.
# For local development with backend running on port 3001:
REACT_APP_API_BASE_URL=http://localhost:3001

# Optional: An alternative variable name also supported by the codebase.
# If both are set, REACT_APP_API_URL takes precedence.
# REACT_APP_API_URL=http://localhost:3001

# API prefix used by the backend for public routes.
# Most Express backends in this project mount routes under /api.
REACT_APP_API_PREFIX=/api

# Fallback port used when REACT_APP_API_BASE_URL is not provided.
# The app will infer the backend origin from window.location.host with this port.
REACT_APP_BACKEND_PORT=3001

# Notes:
# - Copy this file to ".env" and adjust values for your environment.
# - For cloud environments, set REACT_APP_API_BASE_URL to the deployed backend URL,
#   for example:
#   REACT_APP_API_BASE_URL=https://vscode-internal-19172-beta.beta01.cloud.kavia.ai:3001
