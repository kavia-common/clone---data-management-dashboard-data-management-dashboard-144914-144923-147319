# Frontend environment variables (example)

# Backend API base URL (recommended). Example for local dev:
# REACT_APP_API_BASE_URL=http://localhost:3001
# In preview, set to backend preview origin, e.g.:
# REACT_APP_API_BASE_URL=https://<backend-preview-host>:3001

# Optional API prefix (default /api)
REACT_APP_API_PREFIX=/api

# CRA dev server behavior (development only)
HOST=0.0.0.0
PORT=3000
BROWSER=none

# Webpack Dev Server socket settings for containerized/preview environments
WDS_SOCKET_HOST=0.0.0.0
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws

# Allow reverse proxy hosts during development
DANGEROUSLY_DISABLE_HOST_CHECK=true
