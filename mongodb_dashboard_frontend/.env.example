# PUBLIC_INTERFACE
# Backend API base URL and settings for the React frontend.
#
# Recommended for local development:
#   REACT_APP_API_BASE_URL=http://localhost:3001
#   REACT_APP_API_PREFIX=/api
#   REACT_APP_BACKEND_PORT=3001
#
# IMPORTANT: For HTTPS preview environments, leave REACT_APP_API_BASE_URL unset
# and rely on the built-in CRA proxy (src/setupProxy.js). This avoids mixed
# content errors by sending requests to /api via the dev server, which then
# forwards to the backend.
#
# If you must set REACT_APP_API_BASE_URL in HTTPS previews, ensure the backend
# is also reachable over HTTPS at that URL. Otherwise the browser will block
# http calls from an https page.

# One of these is used as API root (API_URL takes precedence)
# REACT_APP_API_URL=
# REACT_APP_API_BASE_URL=http://localhost:3001

# API prefix (default: /api)
REACT_APP_API_PREFIX=/api

# Used by proxy and inference when API base is not provided
REACT_APP_BACKEND_PORT=3001
