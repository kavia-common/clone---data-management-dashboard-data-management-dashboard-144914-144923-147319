# Frontend environment variables
# You can explicitly point the frontend to the backend API base (may include /api suffix)
# If not set, the app will compute from window.location and REACT_APP_BACKEND_PORT (default 3001)
# EITHER of the below may be set; REACT_APP_API_URL takes precedence if both are set
# REACT_APP_API_URL=https://your-backend.example.com/api
# REACT_APP_API_BASE_URL=http://localhost:3001/api

# API prefix used by the backend (only used when computing from window or using relative path)
REACT_APP_API_PREFIX=/api

# Backend port used to compute the API origin from the current window host when explicit URL is not provided
REACT_APP_BACKEND_PORT=3001
