# Frontend environment variables for API connectivity
# IMPORTANT: Do not commit your real .env. Copy this file to .env and adjust values.

# Preferred: Full backend origin (no /api suffix)
# Example for local dev:
# REACT_APP_API_BASE_URL=http://localhost:3001
# Example for cloud preview (replace host accordingly):
# REACT_APP_API_BASE_URL=https://<your-backend-host>:3001
REACT_APP_API_BASE_URL=

# API prefix used by the backend (default /api)
REACT_APP_API_PREFIX=/api

# Optional alternative variable (if your environment provides this):
# If set, it is preferred over REACT_APP_API_BASE_URL
REACT_APP_API_URL=

# Fallback port used to auto-infer API origin when API_BASE_URL is not set
REACT_APP_BACKEND_PORT=3001
