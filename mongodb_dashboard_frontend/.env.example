# Frontend environment example for API base URL
# Preferred: includes '/api' suffix
REACT_APP_API_BASE_URL=https://kavia-dashboard-kavia-dev.cloud.kavia.ai/api

# Alternative (will also be used if REACT_APP_API_BASE_URL is not set)
REACT_APP_API_URL=https://kavia-dashboard-kavia-dev.cloud.kavia.ai/api

# Optional: backend port for CRA proxy in development
REACT_APP_BACKEND_PORT=3001
