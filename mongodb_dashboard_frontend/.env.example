# Frontend environment variables for API connectivity
# For development with CRA proxy, you can omit this (package.json "proxy" forwards /api to http://localhost:3001).
# For production builds or when not using the proxy, set your backend base URL WITHOUT the '/api' suffix.
#
# Example (local backend):
# REACT_APP_API_BASE_URL=http://localhost:3001
#
# Example (deployed backend):
# REACT_APP_API_BASE_URL=https://your-backend.example.com

REACT_APP_API_BASE_URL=
