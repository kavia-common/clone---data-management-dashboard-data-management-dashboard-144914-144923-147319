# Frontend environment variables

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Base URL to the backend server, WITHOUT the /api suffix.
# Example for local dev: http://localhost:3001
# Example for deployed env: https://your-backend.example.com
REACT_APP_API_BASE_URL=http://localhost:3001

# PUBLIC_INTERFACE
# REACT_APP_API_PREFIX
# API path prefix on the backend. Default is /api.
# Change only if your backend mounts routes under a different prefix (e.g., /api/v1).
REACT_APP_API_PREFIX=/api
