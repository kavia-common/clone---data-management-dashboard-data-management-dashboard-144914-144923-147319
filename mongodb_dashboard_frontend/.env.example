# Frontend environment variables for API connectivity

# Base URL for the backend API. If not set, the app will auto-detect using
# window.location.hostname with port REACT_APP_BACKEND_PORT (defaults to 3001).
# Example: http://localhost:3001
REACT_APP_API_BASE_URL=

# API prefix mounted by the backend for public routes. Default: /api
REACT_APP_API_PREFIX=/api

# Backend port used when auto-detecting base URL (ignored if REACT_APP_API_BASE_URL is set)
REACT_APP_BACKEND_PORT=3001
