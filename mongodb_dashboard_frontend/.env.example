# Frontend environment example for development
# PUBLIC_INTERFACE
# Base API URL override (optional)
# REACT_APP_API_BASE_URL=http://localhost:3001

# Single source of truth for tenant encryption salt used in Login flow.
# URL-safe base64 (base64url) without '=' padding, typically 22-24 chars.
# Example: g5StFHvCyj0Hf9g8j87nGA
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
REACT_APP_SECRET_SALT=g5StFHvCyj0Hf9g8j87nGA
