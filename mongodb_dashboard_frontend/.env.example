# Frontend environment configuration
# Preferred: set REACT_APP_API_URL to full base including /api
# Example for local dev:
# REACT_APP_API_URL=http://localhost:3001/api

# Alternatively specify origin and prefix separately:
# REACT_APP_API_BASE_URL=http://localhost:3001
# REACT_APP_API_PREFIX=/api

# Optional: change backend port used for inference when base is not provided
# REACT_APP_BACKEND_PORT=3001

# In some dev setups you may need to disable CRA host check
# REACT_APP_DANGEROUSLY_DISABLE_HOST_CHECK=true
