# Frontend environment example
# Prefer setting full backend base URL when running in preview or remote environments
REACT_APP_API_BASE_URL=http://localhost:3001

# Alternatively, specify host and port separately (used by setupProxy in development)
REACT_APP_PROXY_HOST=localhost
REACT_APP_BACKEND_PORT=3001

# Disable WDS host check if needed for preview platforms that use custom hostnames (use cautiously)
REACT_APP_DANGEROUSLY_DISABLE_HOST_CHECK=false
