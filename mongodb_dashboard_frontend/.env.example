# Frontend environment variables (Create React App)
# Credits conversion rate: how many credits per 1 USD. Defaults to 20000 if not set.
REACT_APP_CREDITS_PER_USD=20000

# Optional: Override API base URL (defaults to static pod URL configured in src/api/client.js)
# REACT_APP_API_BASE_URL=https://your-backend-host:3001
