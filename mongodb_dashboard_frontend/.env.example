# Frontend environment configuration
# If running both frontend (3000) and backend (3001) locally:
# - Leave REACT_APP_API_BASE_URL empty to use the CRA proxy (src/setupProxy.js) which forwards /api and /openapi.json to the backend.
# - Or set REACT_APP_API_BASE_URL to the backend origin (http://localhost:3001).
#
# In HTTPS preview environments, prefer leaving REACT_APP_API_BASE_URL unset so the proxy handles same-origin requests to /api.
# If you set REACT_APP_API_BASE_URL in an https environment, ensure the backend is also accessible over https at that origin.

# Backend API root (optional). Examples:
# REACT_APP_API_BASE_URL=http://localhost:3001
# REACT_APP_API_BASE_URL=https://your-backend.example.com
REACT_APP_API_BASE_URL=

# Alternate var name supported by the client (takes precedence if set)
# REACT_APP_API_URL=

# API prefix used by the backend (default: /api)
REACT_APP_API_PREFIX=/api

# Port used by the proxy fallback when base URL is not set (default: 3001)
REACT_APP_BACKEND_PORT=3001
