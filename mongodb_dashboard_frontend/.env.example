# Frontend environment variables for API connectivity

# Preferred: Full backend origin (protocol + host + port)
# Examples:
#   Local dev (http):
#     REACT_APP_API_BASE_URL=http://localhost:3001
#   Cloud (https) - replace the host as applicable:
#     REACT_APP_API_BASE_URL=https://vscode-internal-13427-beta.beta01.cloud.kavia.ai:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# API prefix under which backend serves public routes
# Keep this as /api unless your backend differs
REACT_APP_API_PREFIX=/api

# Optional: if REACT_APP_API_BASE_URL is not set,
# the app will try to infer backend at [current-host]:REACT_APP_BACKEND_PORT
# Default is 3001
REACT_APP_BACKEND_PORT=3001

# Alternate variable name supported by the client (takes precedence if set)
# REACT_APP_API_URL=
