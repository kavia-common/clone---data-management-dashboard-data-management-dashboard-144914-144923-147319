# Frontend environment configuration
# Ensure all API requests use the Swagger-documented backend base URL.
# Final API base used by the app will be: ${REACT_APP_API_BASE_URL}${REACT_APP_API_PREFIX}

# REQUIRED in cloud preview:
REACT_APP_API_BASE_URL=https://vscode-internal-14377-beta.beta01.cloud.kavia.ai:3001
# Optional override (preferred if both set)
# REACT_APP_API_URL=https://vscode-internal-14377-beta.beta01.cloud.kavia.ai:3001

# API prefix (default /api)
REACT_APP_API_PREFIX=/api

# Note: No localhost defaults. For local development, explicitly set:
# REACT_APP_API_BASE_URL=http://localhost:3001
