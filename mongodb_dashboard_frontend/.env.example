# Frontend environment variables (do not commit real secrets)

# Backend base URL used by the frontend to call APIs.
# Example: https://your-backend.example.com
REACT_APP_API_BASE_URL=

# URL-safe base64 (no padding) tenant encryption salt.
# Preferred: set this to avoid runtime fetch. Do NOT use quotes.
# Example (22-44 chars, URL-safe): NDJfYkxXS1d-Uk5rWlE5WkNn
REACT_APP_SECRET_SALT=
